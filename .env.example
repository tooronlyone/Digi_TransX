# ============================================================
# Digi_TransX — Environment Configuration
# Copy this file to `.env` in the project root and fill it in.
# NEVER commit the real .env file.
# ============================================================

# ---- Supabase (required) -----------------------------------
# Project URL and API keys: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Postgres connection strings: Dashboard -> Project Settings -> Database
# Use the "Session pooler" URI on IPv4 networks. Non-local hosts enforce TLS.
# Dedicated least-privilege database roles (required outside local/test):
DIGITRANSX_API_DB_URL=postgresql://dtx_api_runtime.YOUR-PROJECT-REF:YOUR-API-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DIGITRANSX_SCHEDULER_DB_URL=postgresql://dtx_scheduler_worker.YOUR-PROJECT-REF:YOUR-SCHEDULER-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DIGITRANSX_AUDITOR_DB_URL=postgresql://dtx_auditor_ro.YOUR-PROJECT-REF:YOUR-AUDITOR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# Schema migrations ONLY (never used by Flask runtime, scheduler, or reconciler):
# DIGITRANSX_MIGRATION_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-OWNER-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# Local/test fallback URI only (ignored outside explicit local/test mode):
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# Optional custom CA bundle path (or `certifi` / `system`) for sslmode=verify-full:
# DIGITRANSX_DB_SSLROOTCERT=

# Private storage bucket for all uploaded files (created by supabase/schema.sql)
SUPABASE_STORAGE_BUCKET=shipment-documents

# Max DB connections kept in the backend pool
SUPABASE_DB_POOL_MAX=10

# Required for secure MPIN endpoints: URL-safe base64 encoding of exactly
# 32 random bytes. There is intentionally no application default.
DIGITRANSX_MPIN_PEPPER=

# Timezone used for timestamps shown in the app
APP_TIMEZONE=Asia/Karachi

# ---- Flask -------------------------------------------------
# Required. Use `local` only with the loopback host below; deployed
# environments use `staging` or `production`. Tests set `test` explicitly.
DIGITRANSX_ENVIRONMENT=local
FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
# Number of trusted reverse-proxy hops immediately in front of Flask (0 = ignore forwarded headers)
DIGITRANSX_TRUST_PROXY_COUNT=0

# Local/test simulation only. Never enable this in staging/production.
# With no real payment adapter, card routes fail closed outside explicit local/test mode.
DIGITRANSX_ALLOW_DUMMY_PAYMENTS=false

# ---- Email (OTP / password reset; SMS is not supported) ---
DIGITRANSX_SMTP_HOST=smtp.example.com
DIGITRANSX_SMTP_PORT=587
DIGITRANSX_SMTP_USER=your-smtp-user
DIGITRANSX_SMTP_PASSWORD=your-smtp-password
DIGITRANSX_SMTP_FROM=security@example.com
# Rules 1-4 delivery codes require an independently generated server secret.
# Leave empty to block the affected OTP operation until configured.
DIGITRANSX_DELIVERY_OTP_SECRET=
